    end

    if Config.ESP_Enabled and Config.ESP_Players then
        for _, plr in ipairs(Players:GetPlayers()) do
            if plr ~= LocalPlayer then
                if not ESPData[plr] then CreateESPEntry(plr) end
                local ch = plr.Character
                local hum = ch and ch:FindFirstChildOfClass("Humanoid")
                local root = hum and getRoot(hum, ch)
                local lvl = getLevel(plr)
                local display = plr.DisplayName .. " [Lvl " .. tostring(lvl) .. "]"
                UpdateESPEntry(plr, ch, hum, root, display, ESP_COLOR_PLAYER)
            end
        end
    else
        for key in pairs(ESPData) do
            if key:IsA("Player") then RemoveESPEntry(key) end
        end
    end

    if Config.ESP_Enabled and Config.ESP_Bots then
        local seen = {}
        for _, bot in ipairs(botCache) do
            if bot.model and bot.model.Parent then
                seen[bot.model] = true
                if not ESPData[bot.model] then CreateESPEntry(bot.model) end
                UpdateESPEntry(bot.model, bot.model, bot.hum, bot.root, bot.model.Name, ESP_COLOR_BOT)
            end
        end
        for key in pairs(ESPData) do
            if key:IsA("Model") then
                if not seen[key] or not key.Parent then RemoveESPEntry(key) end
            end
        end
    else
        for key in pairs(ESPData) do
            if key:IsA("Model") then RemoveESPEntry(key) end
        end
    end

    doTelekill()
    doAutoHit()
    doAutoSkill()
end)

