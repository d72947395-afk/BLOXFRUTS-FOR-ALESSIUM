local function shade(c, f)
    return Color3.new(math.clamp(c.R*f,0,1), math.clamp(c.G*f,0,1), math.clamp(c.B*f,0,1))
end
local function round(obj, r)
    local c = Instance.new("UICorner", obj); c.CornerRadius = UDim.new(0, r); return c
end
local function stroke(obj, col, thick, trans)
    local s = Instance.new("UIStroke", obj)
    s.Color = col or Theme.ACCENT
    s.Thickness = thick or 1
    s.Transparency = trans or 0.4
    return s
end

local function getLevel(plr)
    if not plr then return "?" end
    local data = plr:FindFirstChild("Data")
    if data then
        local lvl = data:FindFirstChild("Level")
        if lvl and lvl.Value then return lvl.Value end
    end
    local ls = plr:FindFirstChild("leaderstats")
    if ls then
        local lvl = ls:FindFirstChild("Level") or ls:FindFirstChild("Lvl")
        if lvl and lvl.Value then return lvl.Value end
    end
    local attr = plr:GetAttribute("Level")
    if attr then return attr end
    return "?"
end

