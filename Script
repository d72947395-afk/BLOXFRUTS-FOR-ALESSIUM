local function GetBounds(character, cam)
    if not character or not cam then return nil end
    local minX, minY = math.huge, math.huge
    local maxX, maxY = -math.huge, -math.huge
    local found = false

    for _, object in ipairs(character:GetDescendants()) do
        if object:IsA("BasePart") then
            local sz = object.Size
            if sz.X > 0.4 or sz.Y > 0.4 or sz.Z > 0.4 then
                found = true
                local cf = object.CFrame
                local half = sz / 2
                local corners = {
                    cf * Vector3.new(-half.X, -half.Y, -half.Z),
                    cf * Vector3.new(-half.X, -half.Y,  half.Z),
                    cf * Vector3.new(-half.X,  half.Y, -half.Z),
                    cf * Vector3.new(-half.X,  half.Y,  half.Z),
                    cf * Vector3.new( half.X, -half.Y, -half.Z),
                    cf * Vector3.new( half.X, -half.Y,  half.Z),
                    cf * Vector3.new( half.X,  half.Y, -half.Z),
                    cf * Vector3.new( half.X,  half.Y,  half.Z),
                }
                for _, pos in ipairs(corners) do
                    local screen, visible = cam:WorldToViewportPoint(pos)
                    if visible and screen.Z > 0 then
                        minX = math.min(minX, screen.X)
                        minY = math.min(minY, screen.Y)
                        maxX = math.max(maxX, screen.X)
                        maxY = math.max(maxY, screen.Y)
                    end
                end
            end
        end
    end

    if not found or minX == math.huge then return nil end
    return { X = minX, Y = minY, Width = math.max(maxX - minX, 2), Height = math.max(maxY - minY, 2) }
end

local function SetTracer(frame, x1, y1, x2, y2)
    local dx, dy = x2 - x1, y2 - y1
    local length = math.sqrt(dx * dx + dy * dy)
    frame.Position = UDim2.fromOffset(x1, y1)
    frame.Size = UDim2.fromOffset(length, 2)
    frame.Rotation = math.deg(math.atan2(dy, dx))
end

local function UpdateESPEntry(key, char, hum, root, displayName, boxColor)
    local data = ESPData[key]
    if not data then return end

    if not Config.ESP_Enabled or not char or not hum or hum.Health <= 0 or not char.Parent then
        data.Holder.Visible = false
        return
    end

    local myChar = LocalPlayer.Character
    local myRoot = myChar and myChar:FindFirstChild("HumanoidRootPart")

    if root and myRoot then
        local d = (root.Position - myRoot.Position).Magnitude
        if d > Config.ESP_MaxDistance then
            data.Holder.Visible = false
            return
        end
    end

    local bounds = GetBounds(char, Camera)
    if not bounds then
        data.Holder.Visible = false
        return
    end

    data.Holder.Visible = true
    data.BoxStroke.Color = boxColor
    data.BoxStroke.Thickness = Config.ESP_BoxThickness
    data.Box.Position = UDim2.fromOffset(bounds.X, bounds.Y)
    data.Box.Size = UDim2.fromOffset(bounds.Width, bounds.Height)

    data.Name.Visible = Config.ESP_ShowName
    data.Name.Text = displayName or ""
    data.Name.Position = UDim2.fromOffset(bounds.X, bounds.Y - 18)
    data.Name.Size = UDim2.fromOffset(math.max(bounds.Width, 80), 18)

    data.HealthBack.Visible = Config.ESP_ShowHealth
    data.Health.Visible = Config.ESP_ShowHealth
    data.HealthBack.Position = UDim2.fromOffset(bounds.X - 7, bounds.Y)
    data.HealthBack.Size = UDim2.fromOffset(4, bounds.Height)
    local hp = math.clamp(hum.Health / math.max(hum.MaxHealth, 1), 0, 1)
    data.Health.AnchorPoint = Vector2.new(0, 1)
    data.Health.Position = UDim2.new(0, 0, 1, 0)
    data.Health.Size = UDim2.new(1, 0, hp, 0)
    data.Health.BackgroundColor3 = hp > 0.5 and Color3.fromRGB(60, 220, 200)
        or (hp > 0.25 and Color3.fromRGB(255, 210, 60) or Color3.fromRGB(255, 70, 110))

    data.Distance.Visible = Config.ESP_ShowDistance
    if root and myRoot then
        local d = (root.Position - myRoot.Position).Magnitude
        data.Distance.Text = math.floor(d) .. " studs"
        data.Distance.Position = UDim2.fromOffset(bounds.X, bounds.Y + bounds.Height)
        data.Distance.Size = UDim2.fromOffset(math.max(bounds.Width, 80), 16)
    else
        data.Distance.Text = ""
    end

    data.Tracer.Visible = Config.ESP_Tracer
    if Config.ESP_Tracer then
        data.Tracer.BackgroundColor3 = boxColor
        local vp = Camera.ViewportSize
        SetTracer(data.Tracer, vp.X / 2, vp.Y, bounds.X + bounds.Width / 2, bounds.Y + bounds.Height)
    end
end

