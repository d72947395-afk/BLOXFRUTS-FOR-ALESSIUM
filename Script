    row.MouseButton1Click:Connect(function()
        if tick() - lastClick < 0.15 then return end
        lastClick = tick()
        local ok, state = pcall(callback)
        if not ok then state = not default end
        switch.BackgroundColor3 = state and Theme.ON or Theme.OFF
        knob.Position = state and UDim2.new(1, -20, 0.5, -8) or UDim2.new(0, 3, 0.5, -8)
    end)

    ContentY = ContentY + 40
end

local function addSlider(label, min, max, default, callback)
    local frame = Instance.new("Frame")
    frame.Size = UDim2.new(1, -20, 0, 46)
    frame.Position = UDim2.new(0, 10, 0, ContentY)
    frame.BackgroundColor3 = Theme.PANEL
    frame.BorderSizePixel = 0
    frame.Parent = ContentScroll
    round(frame, 8)

    local lbl = Instance.new("TextLabel")
    lbl.Size = UDim2.new(1, -20, 0, 20)
    lbl.Position = UDim2.new(0, 12, 0, 4)
    lbl.BackgroundTransparency = 1
    lbl.Text = label .. ": " .. default
    lbl.TextColor3 = Theme.TEXT
    lbl.Font = Enum.Font.Gotham
    lbl.TextSize = 12
    lbl.TextXAlignment = Enum.TextXAlignment.Left
    lbl.Parent = frame

    local slider = Instance.new("TextButton")
    slider.Size = UDim2.new(1, -24, 0, 8)
    slider.Position = UDim2.new(0, 12, 1, -18)
    slider.BackgroundColor3 = Theme.ELEMENT
    slider.Text = ""
    slider.BorderSizePixel = 0
    slider.AutoButtonColor = false
    slider.Parent = frame
    round(slider, 4)

    local fill = Instance.new("Frame")
    fill.Size = UDim2.new((default - min) / (max - min), 0, 1, 0)
    fill.BackgroundColor3 = Theme.ACCENT
    fill.BorderSizePixel = 0
    fill.Parent = slider
    round(fill, 4)

    local dragging = false
    local function update(input)
        local rel = math.clamp((input.Position.X - slider.AbsolutePosition.X) / slider.AbsoluteSize.X, 0, 1)
        fill.Size = UDim2.new(rel, 0, 1, 0)
        local val = math.floor((min + (max - min) * rel) * 100 + 0.5) / 100
        lbl.Text = label .. ": " .. val
        pcall(callback, val)
    end

    slider.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            dragging = true; update(input)
        end
    end)
    slider.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            dragging = false
        end
    end)
    UserInputService.InputChanged:Connect(function(input)
        if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
            update(input)
        end
    end)

    ContentY = ContentY + 52
end

local function addDropdown(label, options, default, callback)
    local frame = Instance.new("Frame")
    frame.Size = UDim2.new(1, -20, 0, 34)
