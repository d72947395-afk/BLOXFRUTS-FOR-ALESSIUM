-- ===================== TELEKILL =====================
local telekillState = { target = nil, targetHP = nil, startTime = 0, lastHit = 0 }
local noDamageList = {}

local function isBlacklisted(key)
    local t = noDamageList[key]
    if not t then return false end
    if tick() - t > Config.Telekill_BlacklistTime then
        noDamageList[key] = nil
        return false
    end
    return true
end

local function pickTelekillTarget()
    local myHrp = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
    if not myHrp then return nil end
    local candidates = {}

    if Config.Telekill_Target == "Bots" or Config.Telekill_Target == "Both" then
        for _, bot in ipairs(botCache) do
            if bot.model.Parent and bot.hum.Health > 0 and not isBlacklisted(bot.model) then
                local d = (myHrp.Position - bot.root.Position).Magnitude
                table.insert(candidates, { root = bot.root, hum = bot.hum, key = bot.model, dist = d, name = bot.model.Name })
            end
        end
    end

    if Config.Telekill_Target == "Players" or Config.Telekill_Target == "Both" then
        for _, plr in ipairs(Players:GetPlayers()) do
            if plr ~= LocalPlayer and plr.Character then
                local hum = plr.Character:FindFirstChildOfClass("Humanoid")
                local root = hum and getRoot(hum, plr.Character)
                if hum and hum.Health > 0 and root and not isBlacklisted(plr) then
                    local d = (myHrp.Position - root.Position).Magnitude
                    table.insert(candidates, { root = root, hum = hum, key = plr, dist = d, name = plr.Name })
                end
            end
        end
    end

    table.sort(candidates, function(a, b) return a.dist < b.dist end)
    return candidates[1]
end

local function doTelekill()
    if not Config.Telekill_Enabled then
        telekillState.target = nil
        return
    end

    local c = LocalPlayer.Character
    if not c then return end
    local myHrp = c:FindFirstChild("HumanoidRootPart")
    if not myHrp then return end

    local tgt = telekillState.target

    local needNew = false
    if not tgt then
        needNew = true
    elseif not tgt.root.Parent or tgt.hum.Health <= 0 then
        needNew = true
    elseif tick() - telekillState.startTime > Config.Telekill_Timer then
        if tgt.hum.Health >= (telekillState.targetHP or 0) - 0.5 then
            noDamageList[tgt.key] = tick()
        end
        needNew = true
    end

    if needNew then
        local newTgt = pickTelekillTarget()
        if newTgt then
            telekillState.target = newTgt
            telekillState.targetHP = newTgt.hum.Health
            telekillState.startTime = tick()
            telekillState.lastHit = 0
            tgt = newTgt
        else
            telekillState.target = nil
            return
        end
    end

    if not tgt or not tgt.root.Parent or tgt.hum.Health <= 0 then
        telekillState.target = nil
        return
    end

    local enemyLook = (tgt.hum.RootPart and tgt.hum.RootPart.CFrame.LookVector) or Vector3.new(0, 0, -1)
    local flatLook = Vector3.new(enemyLook.X, 0, enemyLook.Z)
    if flatLook.Magnitude < 0.1 then
        flatLook = (tgt.root.Position - myHrp.Position)
        flatLook = Vector3.new(flatLook.X, 0, flatLook.Z)
    end
    if flatLook.Magnitude > 0.001 then flatLook = flatLook.Unit else flatLook = Vector3.new(0,0,-1) end

    local behindPos = tgt.root.Position - flatLook * Config.Telekill_StandDistance
    behindPos = Vector3.new(behindPos.X, myHrp.Position.Y, behindPos.Z)

    pcall(function()
        myHrp.CFrame = CFrame.new(behindPos, Vector3.new(tgt.root.Position.X, behindPos.Y, tgt.root.Position.Z))
    end)

    if tick() - telekillState.lastHit >= Config.Telekill_HitDelay then
        telekillState.lastHit = tick()
        if Config.AutoHit_Method == "Click" then
            task.spawn(sendVirtualClick)
        else
            local tool = c:FindFirstChildOfClass("Tool")
            if tool then pcall(function() tool:Activate() end) end
        end
    end
end

-- ===================== AUTO HIT =====================
local lastHit = 0
local lastHP = nil
local lastDamageTime = 0

local function doAutoHit()
    if not Config.AutoHit_Enabled then return end
    if Config.Telekill_Enabled then return end
    if tick() - lastHit < Config.HitDelay then return end

    local c = LocalPlayer.Character
    if not c then return end
    local myHrp = c:FindFirstChild("HumanoidRootPart")
    local myHum = c:FindFirstChildOfClass("Humanoid")
    if not myHrp or not myHum or myHum.Health <= 0 then return end

    local damagedRecently = false
    if Config.AutoHit_OnDamage and lastHP then
        if myHum.Health < lastHP - 0.1 then
            lastDamageTime = tick()
        end
        if tick() - lastDamageTime < Config.AutoHit_DamageWindow then
            damagedRecently = true
        end
    end
    lastHP = myHum.Health

    local target, targetHum, bestDist = nil, nil, Config.HitRange
    local function tryTarget(root, hum)
        if root and hum and hum.Health > 0 then
            local d = (myHrp.Position - root.Position).Magnitude
            if d < bestDist then target, targetHum, bestDist = root, hum, d end
        end
    end

    if Config.Aimbot_TargetPlayers then
        for _, plr in ipairs(Players:GetPlayers()) do
            if plr ~= LocalPlayer and plr.Character then
                local hum = plr.Character:FindFirstChildOfClass("Humanoid")
                tryTarget(getRoot(hum, plr.Character), hum)
            end
        end
    end
    if Config.Aimbot_TargetBots then
        for _, bot in ipairs(botCache) do
            if bot.model.Parent then tryTarget(bot.root, bot.hum) end
        end
    end

    if not (target ~= nil or damagedRecently) then return end

    lastHit = tick()

    if Config.Backstab_Enabled and target and targetHum then
        local enemyLook = (targetHum.RootPart and targetHum.RootPart.CFrame.LookVector)
            or (target.CFrame and target.CFrame.LookVector)
            or Vector3.new(0, 0, -1)
        local flatLook = Vector3.new(enemyLook.X, 0, enemyLook.Z)
        if flatLook.Magnitude < 0.1 then
            flatLook = (target.Position - myHrp.Position)
            flatLook = Vector3.new(flatLook.X, 0, flatLook.Z)
        end
        if flatLook.Magnitude > 0.001 then flatLook = flatLook.Unit else flatLook = Vector3.new(0,0,-1) end

        local behindPos = target.Position - flatLook * Config.Backstab_Distance
        behindPos = Vector3.new(behindPos.X, myHrp.Position.Y, behindPos.Z)

        local myDist = (myHrp.Position - target.Position).Magnitude
        if myDist > 4 then
            pcall(function() myHum:MoveTo(behindPos) end)
            return
        end
    end

    if Config.Camera_Lock and target then
        local camPos = Camera.CFrame.Position
        local targetPos = target.Position + Vector3.new(0, 1.5, 0)
        local goal = CFrame.new(camPos, targetPos)
        Camera.CFrame = Camera.CFrame:Lerp(goal, 0.25)
    end

    if Config.AutoHit_Method == "Click" then
        task.spawn(sendVirtualClick)
    else
        local tool = c:FindFirstChildOfClass("Tool")
        if tool then pcall(function() tool:Activate() end) end
    end
end

-- ===================== AUTO SKILL =====================
local skillCooldown = 0
local function doAutoSkill()
    if not Config.AutoSkill_Enabled then return end
    if tick() - skillCooldown < 2 then return end
    skillCooldown = tick()
    if not LocalPlayer.Character then return end
    task.spawn(function()
        for _, key in ipairs({"Z", "X", "C", "V"}) do
            pcall(function()
                VirtualInputManager:SendKeyEvent(true, key, false, game)
            end)
            task.wait(0.2)
            pcall(function()
                VirtualInputManager:SendKeyEvent(false, key, false, game)
            end)
            task.wait(0.1)
        end
    end)
end

