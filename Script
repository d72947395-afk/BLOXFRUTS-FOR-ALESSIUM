local function matchesAny(str, list)
    if not str or #str == 0 then return false end
    for _, kw in ipairs(list) do
        if string.find(str, kw, 1, true) then return true end
    end
    return false
end

local function collectNameStrings(model, hum)
    local names = { model.Name }
    if hum and hum.DisplayName and #hum.DisplayName > 0 and hum.DisplayName ~= "Humanoid" then
        table.insert(names, hum.DisplayName)
    end
    for _, obj in ipairs(model:GetDescendants()) do
        if obj:IsA("TextLabel") or obj:IsA("TextButton") or obj:IsA("TextBox") then
            local txt = obj.Text
            if txt and #txt > 0 and #txt < 100 then table.insert(names, txt) end
        end
    end
    return names
end

local function isNPC(model, hum)
    if not model or not hum then return true end
    local names = collectNameStrings(model, hum)
    for _, n in ipairs(names) do
        for _, kw in ipairs(HARD_NPC_KEYWORDS) do
            if string.find(n, kw, 1, true) then return true end
        end
    end
    for _, n in ipairs(names) do
        if matchesAny(n, ENEMY_WHITELIST) then return false end
    end
    local parent = model.Parent
    if parent then
        local pname = parent.Name:lower()
        if pname == "vendors" or pname == "shops" or pname == "npcs" then return true end
    end
    return false
end

