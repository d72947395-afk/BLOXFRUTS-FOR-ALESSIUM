local function getRoot(hum, model)
    if hum and hum.RootPart then return hum.RootPart end
    if model then
        return model:FindFirstChild("HumanoidRootPart")
            or model:FindFirstChild("UpperTorso")
            or model:FindFirstChild("Torso")
            or model.PrimaryPart
    end
    return nil
end

local function scanBots()
    botCache = {}
    local myChar = LocalPlayer.Character
    local ok, descendants = pcall(function() return workspace:GetDescendants() end)
    if not ok or not descendants then return end

    for _, obj in ipairs(descendants) do
        if obj:IsA("Model") and obj ~= myChar then
            if not Players:GetPlayerFromCharacter(obj) then
                local hum = obj:FindFirstChildOfClass("Humanoid")
                if hum and hum.Health > 0 then
                    if not (Config.ESP_IgnoreNPCs and isNPC(obj, hum)) then
                        local root = getRoot(hum, obj)
                        if root then
                            table.insert(botCache, {model = obj, hum = hum, root = root})
                        end
                    end
                end
            end
        end
    end
end

-- ===================== AIMBOT =====================
local currentAimTarget = nil

local function findAimTarget()
    local center = Vector2.new(Camera.ViewportSize.X / 2, Camera.ViewportSize.Y / 2)
    local camPos = Camera.CFrame.Position
    local bestHrp, bestName, bestDist = nil, nil, math.huge

    local function tryHrp(hrp, name)
        if not hrp or not hrp.Parent then return end
        local pos = hrp.Position
        local sp, onScreen = Camera:WorldToViewportPoint(pos)
        if not onScreen then return end
        local sd = (Vector2.new(sp.X, sp.Y) - center).Magnitude
        if sd > Config.Aimbot_FOV then return end
        local wd = (camPos - pos).Magnitude
        if wd < bestDist then bestHrp, bestName, bestDist = hrp, name, wd end
    end

    if Config.Aimbot_TargetPlayers then
        for _, plr in ipairs(Players:GetPlayers()) do
            if plr ~= LocalPlayer then
                local ch = plr.Character
                if ch then
                    local hum = ch:FindFirstChildOfClass("Humanoid")
                    if hum and hum.Health > 0 then tryHrp(getRoot(hum, ch), plr.Name) end
                end
            end
        end
    end

    if Config.Aimbot_TargetBots then
        for _, bot in ipairs(botCache) do
            if bot.model.Parent and bot.hum.Health > 0 then
                tryHrp(bot.root, bot.model.Name)
            end
        end
    end

    return bestHrp, bestName
end

local function aimStep()
    if not Config.Aimbot_Enabled then
        currentAimTarget = nil
        return
    end
    local hrp, name = findAimTarget()
    currentAimTarget = name
    if hrp then
        local camPos = Camera.CFrame.Position
        local targetPos = hrp.Position + Vector3.new(0, 1.5, 0)
        local goal = CFrame.new(camPos, targetPos)
        if Config.Aimbot_Smoothness >= 0.95 then
            Camera.CFrame = goal
        else
            Camera.CFrame = Camera.CFrame:Lerp(goal, Config.Aimbot_Smoothness)
        end
    end
end

RunService:BindToRenderStep("BF_Aimbot", Enum.RenderPriority.Camera.Value + 1, aimStep)

