local TabButtons = {}
local TabOrder = {"home", "visual", "combat", "settings"}
local ActiveTab = "home"

local function refreshTabs()
    for _, key in ipairs(TabOrder) do
        local btn = TabButtons[key]
        local active = (key == ActiveTab)
        btn.BackgroundColor3 = active and Theme.PANEL_2 or Theme.PANEL
        btn.TextColor3 = active and Theme.ACCENT or Theme.TEXT_DIM
        if btn:FindFirstChild("Indicator") then
            btn.Indicator.BackgroundTransparency = active and 0 or 1
        end
    end
end

local function createTab(key, index)
    local btn = Instance.new("TextButton")
    btn.Size = UDim2.new(1, -16, 0, 40)
    btn.Position = UDim2.new(0, 8, 0, 8 + (index - 1) * 46)
    btn.BackgroundColor3 = Theme.PANEL
    btn.Text = T(key)
    btn.TextColor3 = Theme.TEXT_DIM
    btn.Font = Enum.Font.GothamMedium
    btn.TextSize = 14
    btn.BorderSizePixel = 0
    btn.AutoButtonColor = false
    btn.ZIndex = 7
    btn.TextXAlignment = Enum.TextXAlignment.Left
    btn.Parent = TabContainer
    round(btn, 8)

    local ind = Instance.new("Frame")
    ind.Name = "Indicator"
    ind.Size = UDim2.new(0, 3, 0, 22)
    ind.Position = UDim2.new(0, 0, 0.5, -11)
    ind.BackgroundColor3 = Theme.ACCENT
    ind.BorderSizePixel = 0
    ind.BackgroundTransparency = 1
    ind.ZIndex = 8
    ind.Parent = btn
    round(ind, 2)

    btn.MouseEnter:Connect(function()
        if ActiveTab ~= key then
            btn.BackgroundColor3 = Theme.ELEMENT
            btn.TextColor3 = Theme.TEXT
        end
    end)
    btn.MouseLeave:Connect(function()
        if ActiveTab ~= key then
            btn.BackgroundColor3 = Theme.PANEL
            btn.TextColor3 = Theme.TEXT_DIM
        end
    end)
    btn.MouseButton1Click:Connect(function()
        ActiveTab = key
        refreshTabs()
        if key == "home" then showHome()
        elseif key == "visual" then showVisual()
        elseif key == "combat" then showCombat()
        elseif key == "settings" then showSettings() end
    end)

    TabButtons[key] = btn
end

for i, key in ipairs(TabOrder) do createTab(key, i) end

